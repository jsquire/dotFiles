{
  "$schema": "https://json.schemastore.org/template",
  "author": "Jesse Squire",
  "classifications": [
    "C#",
    ".NET",
    "Solution"
  ],
  "description": "Creates a .NET solution with agent guidance, centralized build settings, NUnit tests, CI, and dependency updates.",
  "identity": "Jesse.CSharp.Solution",
  "name": "Jesse C# Solution",
  "shortName": "jesse-csharp",
  "sourceName": "Jesse.Project-1",
  "preferNameDirectory": false,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "forms": {
    "identity": {
      "identifier": "replace",
      "pattern": "^",
      "replacement": ""
    },
    "namespaceCharacters": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9]",
      "replacement": ""
    },
    "namespacePrefix": {
      "identifier": "replace",
      "pattern": "^",
      "replacement": "Project"
    },
    "namespaceName": {
      "identifier": "chain",
      "steps": [
        "namespaceCharacters",
        "namespacePrefix"
      ]
    }
  },
  "symbols": {
    "projectPathName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "__PROJECT_PATH_NAME__"
    },
    "rootNamespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "namespaceName",
      "replaces": "__ROOT_NAMESPACE__"
    },
    "copyrightYear": {
      "type": "generated",
      "generator": "now",
      "replaces": "copyrightYear",
      "parameters": {
        "format": "yyyy"
      }
    },
    "kestrelHttpPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "__HTTP_PORT__",
      "parameters": {
        "low": 5000,
        "high": 5300
      }
    },
    "kestrelHttpsPort": {
      "type": "generated",
      "generator": "port",
      "replaces": "__HTTPS_PORT__",
      "parameters": {
        "low": 7000,
        "high": 7300
      }
    },
    "location": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": ".",
      "fileRename": "__LOCATION__",
      "displayName": "Location",
      "description": "Containing directory for the generated solution. Relative paths are resolved from the current directory."
    },
    "apptype": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "console",
      "displayName": "Application type",
      "description": "Selects the application project created under src.",
      "replaces": "__APPTYPE__",
      "choices": [
        {
          "choice": "class-library",
          "description": "Creates a reusable class library."
        },
        {
          "choice": "console",
          "description": "Creates a command-line application."
        },
        {
          "choice": "web-api",
          "description": "Creates a minimal ASP.NET Core Web API."
        },
        {
          "choice": "worker",
          "description": "Creates a .NET worker service."
        }
      ]
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        "**/variants/**",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.git/**",
        "**/.vs/**",
        "**/*.user",
        "**/*.lock.json",
        "**/*.filelist"
      ],
      "rename": {
        "__LOCATION__/AGENTS.md.template": "__LOCATION__/AGENTS.md",
        "__LOCATION__/editorconfig.template": "__LOCATION__/.editorconfig",
        "__LOCATION__/gitignore.template": "__LOCATION__/.gitignore",
        "__LOCATION__/gitattributes.template": "__LOCATION__/.gitattributes",
        "__LOCATION__/.github/instructions/csharp.instructions.md.template": "__LOCATION__/.github/instructions/csharp.instructions.md"
      },
      "modifiers": [
        {
          "condition": "(apptype == \"console\")",
          "exclude": [
            "__LOCATION__/src/Jesse.Project-1/GreetingService.cs",
            "__LOCATION__/tests/GreetingServiceTests.cs"
          ]
        }
      ]
    },
    {
      "condition": "(apptype == \"class-library\")",
      "source": "./",
      "target": "./",
      "include": [
        "__LOCATION__/variants/class-library/**"
      ],
      "rename": {
        "__LOCATION__/variants/class-library/src/Jesse.Project-1/Jesse.Project-1.csproj": "__LOCATION__/src/Jesse.Project-1/Jesse.Project-1.csproj"
      }
    },
    {
      "condition": "(apptype == \"console\")",
      "source": "./",
      "target": "./",
      "include": [
        "__LOCATION__/variants/console/**"
      ],
      "rename": {
        "__LOCATION__/variants/console/src/Jesse.Project-1/Jesse.Project-1.csproj": "__LOCATION__/src/Jesse.Project-1/Jesse.Project-1.csproj",
        "__LOCATION__/variants/console/src/Jesse.Project-1/EntryPoint.cs": "__LOCATION__/src/Jesse.Project-1/EntryPoint.cs",
        "__LOCATION__/variants/console/tests/EntryPointTests.cs": "__LOCATION__/tests/EntryPointTests.cs"
      }
    },
    {
      "condition": "(apptype == \"web-api\")",
      "source": "./",
      "target": "./",
      "include": [
        "__LOCATION__/variants/web-api/**"
      ],
      "rename": {
        "__LOCATION__/variants/web-api/src/Jesse.Project-1/Jesse.Project-1.csproj": "__LOCATION__/src/Jesse.Project-1/Jesse.Project-1.csproj",
        "__LOCATION__/variants/web-api/src/Jesse.Project-1/Program.cs": "__LOCATION__/src/Jesse.Project-1/Program.cs",
        "__LOCATION__/variants/web-api/src/Jesse.Project-1/Properties/launchSettings.json": "__LOCATION__/src/Jesse.Project-1/Properties/launchSettings.json",
        "__LOCATION__/variants/web-api/src/Jesse.Project-1/appsettings.Development.json": "__LOCATION__/src/Jesse.Project-1/appsettings.Development.json",
        "__LOCATION__/variants/web-api/src/Jesse.Project-1/appsettings.json.template": "__LOCATION__/src/Jesse.Project-1/appsettings.json"
      }
    },
    {
      "condition": "(apptype == \"worker\")",
      "source": "./",
      "target": "./",
      "include": [
        "__LOCATION__/variants/worker/**"
      ],
      "rename": {
        "__LOCATION__/variants/worker/src/Jesse.Project-1/Jesse.Project-1.csproj": "__LOCATION__/src/Jesse.Project-1/Jesse.Project-1.csproj",
        "__LOCATION__/variants/worker/src/Jesse.Project-1/Program.cs": "__LOCATION__/src/Jesse.Project-1/Program.cs",
        "__LOCATION__/variants/worker/src/Jesse.Project-1/Worker.cs": "__LOCATION__/src/Jesse.Project-1/Worker.cs",
        "__LOCATION__/variants/worker/src/Jesse.Project-1/appsettings.json.template": "__LOCATION__/src/Jesse.Project-1/appsettings.json"
      }
    }
  ]
}
