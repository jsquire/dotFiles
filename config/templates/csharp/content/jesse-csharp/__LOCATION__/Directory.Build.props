<Project>
  <!-- Project Metadata -->
  <PropertyGroup>
    <Authors>Jesse Squire</Authors>
    <Copyright>Copyright (c) Jesse Squire. All rights reserved.</Copyright>
    <Product>__PROJECT_PATH_NAME__</Product>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!-- Versioning -->
  <PropertyGroup>
    <Version>0.0.1-dev.1</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <!-- Configuration -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <WarningsAsErrors Condition="'$(GITHUB_ACTIONS)' == 'true'">$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Custom Properties -->
  <PropertyGroup>
    <CommonTargetFramework>net10.0</CommonTargetFramework>
  </PropertyGroup>
</Project>
