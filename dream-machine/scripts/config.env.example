# dream-machine / AdGuard failover configuration
#
# Copy this file to config.env and edit for your environment.
# It is sourced by both the installer (on the workstation) and by
# dns-failover.sh (on the UDM after deployment).
#
# All variables use POSIX shell syntax; no spaces around '='.

# ------------------------------------------------------------------
# UDM / SSH — used only by install.sh and the test and uninstall scripts
# ------------------------------------------------------------------

# Hostname or IP of the UDM SE, reachable over SSH from the workstation.
UDM_HOST="192.168.1.1"

# SSH user on the UDM (root on stock UniFi OS).
UDM_SSH_USER="root"

# ------------------------------------------------------------------
# AdGuard Home — the primary DNS resolver
# ------------------------------------------------------------------

# IP address of your AdGuard Home instance. Handed to clients as DNS 1.
#
# This address is NEVER impersonated or taken over by the UDM. SSH and every
# other service on the AdGuard host stay reachable during an outage, which is
# a hard requirement of the design.
ADGUARD_IP="192.168.1.99"

# ------------------------------------------------------------------
# Failover address — the absent standby
# ------------------------------------------------------------------

# Handed to clients as DNS 2. This address does NOT exist on the network while
# AdGuard is healthy; the daemon binds it to LAN_IF only during an outage.
#
# That absence is the whole point of the design and must not be "simplified"
# away. A secondary DNS server that is always reachable gets used
# opportunistically by resolvers that round-robin, race, or prefer whichever
# answered fastest — silently bypassing AdGuard during normal operation.
# Because this address does not exist while AdGuard is healthy, every client is
# forced onto AdGuard and its per-client attribution and filtering are never
# disturbed.
#
# MUST be outside the DHCP pool. A client leasing this address would collide
# with failover at the worst possible moment, intermittently and confusingly.
# UniFi's default LAN pool starts at .6, so .2-.5 are structurally excluded
# with no configuration to maintain.
FAILOVER_IP="192.168.1.2"

# LAN bridge the failover address is bound to. The UDM's dnsmasq must list this
# interface in its `interface=` directives and be running `bind-dynamic`, or it
# will not pick the address up.
LAN_IF="br0"

# ------------------------------------------------------------------
# Primary probe — is AdGuard serving usable answers?
# ------------------------------------------------------------------

# Domain resolved against AdGuard to test liveness.
#
# MUST be a name AdGuard will not filter. A blocked name returns NXDOMAIN or a
# sinkhole address, which reads as success and would prevent failover from ever
# firing.
PROBE_NAME="dns.quad9.net"

# Seconds a single query may take before it counts as a timeout.
PROBE_TIMEOUT=2

# Seconds between probes.
INTERVAL=10

# Consecutive failed primary probes required before failover is considered.
# Worst-case detection latency is INTERVAL x FAIL_THRESHOLD + PROBE_TIMEOUT.
# At the defaults that is 32s; dropping INTERVAL to 5 roughly halves it.
FAIL_THRESHOLD=3

# Consecutive successful primary probes required to declare AdGuard UP again
# and withdraw the failover address.
RECOVER_THRESHOLD=3

# ------------------------------------------------------------------
# Corroborating probe — would failing over actually help?
# ------------------------------------------------------------------
#
# Runs ONLY once the primary probe has failed FAIL_THRESHOLD times, never
# during normal operation. It prevents failover from misfiring during a WAN
# outage, where AdGuard and the UDM are equally broken and swapping between
# them accomplishes nothing but flapping.

# Resolver to ask. This is deliberately the UDM's own dnsmasq rather than an
# upstream, because it is the exact path FAILOVER_IP will serve during an
# outage — testing anything else tests the wrong thing.
#
# If dnsmasq is not reachable on loopback on your firmware build, set this to
# the LAN bridge address (e.g. 192.168.1.1) instead.
CORROBORATE_SERVER="127.0.0.1"

# Zone under which a RANDOM label is queried each time. The random label is
# mandatory cache-busting: dnsmasq runs a large cache, so a fixed name could be
# answered from cache and vouch for an upstream that is entirely unreachable.
# A fresh label cannot be cached, positive or negative, so it forces real
# recursion.
#
# What makes the probe valid is that cache is bypassed, not which success code
# comes back. Either NOERROR or NXDOMAIN is accepted, because producing either
# one requires the full chain to have worked. Measured against example.com the
# answer is NOERROR with an empty answer section, not NXDOMAIN.
#
# If you change this, pick a zone that resolves reliably and does NOT wildcard
# to a real address you might depend on. tests/test-parsing.sh checks that a
# random label under this zone still yields a success code.
CORROBORATE_ZONE="example.com"

# ------------------------------------------------------------------
# Upstream drift guard
# ------------------------------------------------------------------

# The UDM's own resolver configuration. If ADGUARD_IP ever appears here, the
# fallback would forward into the same dead resolver and the design is inert.
# The daemon re-checks this every iteration and logs on transition only.
RESOLV_FILE="/run/resolv.conf.d/main"

# ------------------------------------------------------------------
# Tier 2 test behaviour
# ------------------------------------------------------------------
#
# Tier 2 tests induce failure by severing the UDM's own view of AdGuard with
# reversible, UDM-local iptables rules. AdGuard is never touched and stays
# healthy throughout.
#
# The one genuine client-visible effect is the standby address itself: once
# FAILOVER_IP is advertised in DHCP, binding it makes it a live resolver for
# every client holding a lease, and those clients resolve UNFILTERED and
# UNATTRIBUTED for as long as it is bound.

# Ships as "yes", which is the cautious reading: Tier 2 assumes binding the
# standby is client-visible and demands a maintenance window.
#
# Set to "no" ONLY once you have confirmed FAILOVER_IP is not yet in the DHCP
# DNS list. That is the case on a fresh install, and it is why the documented
# deployment sequence runs the full Tier 2 suite BEFORE advertising the standby.
# While this is "no", Tier 2 runs carry NO client exposure at all and need no
# maintenance window.
#
# Set it back to "yes" at the same time you add FAILOVER_IP to DHCP.
#
# If this variable is unset entirely, tests/lib.sh assumes "yes" — a missing
# answer must not be read as "no exposure".
STANDBY_IN_DHCP="yes"

# Ceiling, in seconds, on how long the standby may stay bound during one test
# run. Exceeding it triggers a forced teardown and a distinct exit code (3),
# separating "the test failed" from "the test failed AND cleanup may be
# incomplete".
#
# Leave unset to derive it from the timing parameters above. The standby cannot
# come down faster than RECOVER_THRESHOLD x INTERVAL, so a ceiling below that
# fires spuriously on healthy runs.
# MAX_ENGAGED_SECS=120

# SSH user on the AdGuard host. Optional, and used only for a secondary
# assertion that the host stays administrable while failover is engaged — the
# requirement that killed the previous design. The primary assertion for that
# property is that no UDM interface has ADGUARD_IP bound, which needs no
# credentials. Leave blank to skip the secondary check.
ADGUARD_SSH_USER=""

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------

# Kept inside the install directory so uninstall removes it with everything
# else and leaves nothing orphaned. /data survives firmware updates;
# /var/log does not.
LOG_FILE="/data/adguard-failover/failover.log"

# Rotate (truncate) the log when it exceeds this many bytes.
LOG_MAX_BYTES=5242880
